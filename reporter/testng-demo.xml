<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Demo suite: intentional failed / broken / skipped / flaky tests to show Allure report features.
     Run with: mvn clean test -Dsuite=testng-demo.xml -->
<suite name="AutoReporter Demo Suite" verbose="1">

    <!-- chrome | firefox | edge -->
    <parameter name="browser" value="chrome"/>

    <test name="Report Status Demo">
        <classes>
            <class name="com.ucsc.automation.TS_ReportDemo.TS_ReportDemo"/>
        </classes>
    </test>

    <test name="Flaky Test Demo">
        <classes>
            <class name="com.ucsc.automation.TS_Flaky.TS_Flaky"/>
        </classes>
    </test>
</suite>
