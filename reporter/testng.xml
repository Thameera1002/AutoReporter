<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutoReporter Suite" verbose="1">

    <!-- Remove or change to run on another browser: chrome | firefox | edge -->
    <parameter name="browser" value="chrome"/>

    <test name="Login Tests">
        <classes>
            <class name="com.ucsc.automation.TS_Common.TS_Common"/>
        </classes>
    </test>

    <test name="Dashboard Tests">
        <classes>
            <class name="com.ucsc.automation.TS_Dashboard.TS_Dashboard"/>
        </classes>
    </test>

    <!-- Intentional failed / broken / skipped tests to demo Allure statuses. Remove when not needed. -->
    <test name="Report Status Demo">
        <classes>
            <class name="com.ucsc.automation.TS_ReportDemo.TS_ReportDemo"/>
        </classes>
    </test>

    <!-- Intentional flaky tests to demo RetryAnalyzer + Allure Retries tab. Remove when not needed. -->
    <test name="Flaky Test Demo">
        <classes>
            <class name="com.ucsc.automation.TS_Flaky.TS_Flaky"/>
        </classes>
    </test>
</suite>
