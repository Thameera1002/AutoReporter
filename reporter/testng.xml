<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Real tests. Default suite for local runs and Jenkins.
     Demo tests (intentional failed/broken/skipped/flaky) are in testng-demo.xml. -->
<suite name="AutoReporter Suite" verbose="1">

    <!-- chrome | firefox | edge -->
    <parameter name="browser" value="chrome"/>

    <test name="Login Tests">
        <classes>
            <class name="com.ucsc.automation.TS_Common.TS_Common"/>
        </classes>
    </test>

    <test name="Dashboard Tests">
        <classes>
            <class name="com.ucsc.automation.TS_Dashboard.TS_Dashboard"/>
        </classes>
    </test>
</suite>
